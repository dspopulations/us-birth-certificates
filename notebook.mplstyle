figure.figsize: 4.1,2.9
figure.dpi: 120.0
figure.facecolor: white
figure.constrained_layout.use: True

font.family: sans-serif, DejaVu Sans
font.sans-serif: "Aptos Narrow", "Noto Sans Condensed", Aptos, "Helvetica Neue", Arial, Helvetica, DejaVu Sans
font.size: 9

text.color: "#202020"

pcolormesh.snap: True

figure.titlesize: 9
figure.titleweight: bold

axes.labelsize: 9
axes.titlesize: 9
axes.titleweight: bold
axes.labelweight: bold
axes.labelcolor: "#202020"
axes.axisbelow: True
axes.grid: True
axes.grid.which: major
axes.facecolor: white
axes.edgecolor: "#d2d8df"
axes.linewidth: 0

grid.linestyle: -
grid.color: "#d2d8df"
grid.linewidth: 0.25
grid.alpha: 1

xtick.labelsize: 9
ytick.labelsize: 9
xtick.color:  "#202020"
ytick.color:  "#202020"
xtick.direction: out
ytick.direction: out
xtick.major.size: 0
ytick.major.size: 0
xtick.minor.size: 0
ytick.minor.size: 0

lines.solid_capstyle: round

scatter.marker: o

patch.edgecolor: "#ffffffff"
patch.linewidth: 0.75
patch.antialiased: True

legend.fontsize: 9
legend.title_fontsize: 9
legend.frameon: True
legend.numpoints: 1
legend.scatterpoints: 1
